<div class="chiphippo-embed" data-chiphippo-embed>
  <iframe
    src="{{ src }}"
    title="{{ title|default('Interactive Chip Hippo circuit') }}"
    loading="lazy"
    sandbox="allow-scripts allow-same-origin allow-downloads"
    allow="clipboard-write; fullscreen"
    referrerpolicy="strict-origin-when-cross-origin"
    style="height: {{ height|default(720) }}px"
  ></iframe>
</div>
